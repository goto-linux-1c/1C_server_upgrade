#!/opt/executor/executor

//Каталоги по умолчанию для различных ОС
конст КаталогПоУмолчанию1СWindows = "C:\\Program Files\\1cv8"
конст КаталогПоУмолчанию1СLinux = "/opt/1cv8/x86_64"
конст КаталогПоУмолчаниюWWWWindows = "C:\\inetpub\\wwwroot"
конст КаталогПоУмолчаниюWWWLinux = "/etc/httpd"
//Проверка количества переданных аргументов, установка номера релиза и каталого веб-публикации в зависимости от ОС
метод Скрипт(Версия1С: Строка = "", РабочийКаталогWWW: Строка = "")
    пер ЭтоWindows: Булево

    ЭтоWindows = ТипОС()

    если Версия1С.Пусто() и РабочийКаталогWWW.Пусто()
        Консоль.Записать(
            "Using the script\n <script> parameter1 parameter2\nWhere parameter1 is the 1C platform version, parameter2 is the web publication directory\nIf the parameters are not specified, the default values ​​will be used")
        Консоль.Записать("For example: <script> 8.3.25.1394 C:\\inetpub\\wwwroot\n\n")
    ;
    если Версия1С.Пусто()
        пер РабочийКаталог1С = ЭтоWindows ? КаталогПоУмолчанию1СWindows : КаталогПоУмолчанию1СLinux
        Версия1С = НайтиМаксимальнуюВерсиюПлатформы(РабочийКаталог1С)
    ;
    если РабочийКаталогWWW.Пусто()
        РабочийКаталогWWW = ЭтоWindows ? КаталогПоУмолчаниюWWWWindows : КаталогПоУмолчаниюWWWLinux
    ;
    если РабочийКаталогWWW.ЗаканчиваетсяНа(Файлы.СимволРазделителя) или РабочийКаталогWWW.ЗаканчиваетсяНа("\"")
        РабочийКаталогWWW = РабочийКаталогWWW.ПодстрокаСНачала(РабочийКаталогWWW.Длина() - 1)
    ;
    если Версия1С.Пусто()
        Консоль.Записать("Unable to determine the 1C platform version, run the script with parameters")
        возврат
    ;

    Консоль.Записать("The following version of the 1C platform will be used:\n" + Версия1С.ВСтроку())
    Консоль.Записать("web publication directory:\n" + РабочийКаталогWWW.ВСтроку())
    пер ПродолжитьРаботу = Консоль.СчитатьСимвол("\n\nContinue execution?\n0-yes, another character-no\n")
    если ПродолжитьРаботу != "0"
        возврат
    ;
    //Поиск файлов веб-публикаций
    пер МассивФайлыВебПубликаций = НайтиФайлыВебПубликаций(РабочийКаталогWWW, ЭтоWindows)
    //Замена номера релиза на актуальный
    для НайденныйФайл из МассивФайлыВебПубликаций
        если (ЭтоWindows и НайденныйФайл.Имя == "web.config") или (НайденныйФайл.Имя.ПодстрокаСКонца(5) == ".conf")
            ЗаменитьСтрокиФайла(НайденныйФайл, Версия1С, ЭтоWindows)
        ;
    ;
;

метод ТипОС(): Булево
    возврат СредаИсполнения.ПолучитьПеременную("OS").Содержит("Windows", Истина)
;

метод НайтиМаксимальнуюВерсиюПлатформы(РабочийКаталог1С: Строка): Строка
    пер ФайлРабочийКаталог1С = новый Файл(РабочийКаталог1С)
    если не ФайлРабочийКаталог1С.Существует()
        возврат ""
    ;
    знч НастройкиПоиска = новый НастройкиПоискаФайлов()
    НастройкиПоиска.ИсключитьСсылки(Истина)
        .МаксимальнаяГлубина(1)
        .ИсключитьФайлы(Истина)

    знч ОбразецДляПоискаСочетаний = '[8][.]\d+[.]\d+[.]\d+'
    пер НайденныеФайлы = Файлы.Найти(РабочийКаталог1С, НастройкиПоиска)
    пер НайденныеКаталоги = новый Массив<Строка>()

    для НайденныйФайл из НайденныеФайлы
        если НайденныйФайл.ЭтоКаталог()
            пер МассивСовпадения = ОбразецДляПоискаСочетаний.НайтиСовпадения(НайденныйФайл.Имя)
            если МассивСовпадения.Размер() > 0
                НайденныеКаталоги.Добавить(НайденныйФайл.Имя)
            ;
        ;
    ;
    если НайденныеКаталоги.Размер() > 0
        НайденныеКаталоги = НайденныеКаталоги.Сортировать(НаправлениеСортировки.ПоУбыванию)
        возврат НайденныеКаталоги[0]
    ;
    возврат ""
;

метод НайтиФайлыВебПубликаций(РабочийКаталогWWW: Строка, ЭтоWindows: Булево): ЧитаемыйМассив<Файл>
    пер ФайлРабочийКаталогWWW = новый Файл(РабочийКаталогWWW)
    если не ФайлРабочийКаталогWWW.Существует()
        возврат []
    ;
    знч НастройкиПоиска = новый НастройкиПоискаФайлов()
    НастройкиПоиска.ИмяСодержит(ЭтоWindows ? "web.config" : ".conf")
        .ИсключитьКаталоги(Истина)
        .Размер(От = 1б)

    возврат Файлы.Найти(РабочийКаталогWWW, НастройкиПоиска)
;

метод ЗаменитьСтрокиФайла(НайденныйФайл: Файл, Версия1С: Строка, ЭтоWindows: Булево)
    попытка
        Консоль.Записать("Processing file\n" + НайденныйФайл.Путь)
        исп ПотокЧтения = НайденныйФайл.ОткрытьПотокЧтения()
        знч ЧтениеДанных = новый ЧтениеДанных(ПотокЧтения)
        знч ОбразецДляПоискаСочетаний = '(?<platform>[8][.]\d+[.]\d+[.]\d+)'

        исп ВременныйПоток = новый ВременныйПотокЗаписи()
        знч НастройкиЗаписи = новый НастройкиЗаписиДанных()
        НастройкиЗаписи.РазделительСтрок = ЭтоWindows ? "\в\н" : "\н"
        НастройкиЗаписи.Кодировка = "UTF-8"

        знч ВременныйЗаписьДанных = новый ЗаписьДанных(ВременныйПоток, НастройкиЗаписи)
        пер НайденоСовпадение = Ложь

        пока не ЧтениеДанных.ЧтениеЗавершено()
            пер СтрокаФайла = ЧтениеДанных.ПрочитатьСтроку()
            если (СтрокаФайла.Длина() > 0 и СтрокаФайла[0] != "#")
                пер МассивСовпадения = ОбразецДляПоискаСочетаний.НайтиСовпадения(СтрокаФайла)
                если МассивСовпадения.Размер() > 0
                    СтрокаФайла = СтрокаФайла.Заменить(МассивСовпадения[0].Группа("platform"), Версия1С)
                    НайденоСовпадение = Истина
                ;
            ;

            ВременныйЗаписьДанных.ЗаписатьСтроку(СтрокаФайла)
        ;
        ПотокЧтения.Закрыть()

        если НайденоСовпадение
            знч НовоеИмяФайла =
                НайденныйФайл.Путь.Заменить(ЭтоWindows ? "web.config" : ".conf", (ЭтоWindows ? "web.config." : ".conf.") + ДатаВремя.Сейчас().Представление("гггг_ММ_дд_ЧЧ_мм_сс") + ".bak")
            Консоль.Записать("Make copy\n" + НовоеИмяФайла)
            Файлы.Переместить(НайденныйФайл.Путь, НовоеИмяФайла)
            знч НовыйФайл = новый Файл(НайденныйФайл.Путь)
            исп ПотокЗаписи = НовыйФайл.ОткрытьПотокЗаписи()
            знч ЗаписьДанных = новый ЗаписьДанных(ПотокЗаписи, НастройкиЗаписи)
            ЗаписьДанных.ЗаписатьСтроку(ВременныйПоток.ОткрытьПотокЧтения().ПрочитатьКакСтроку())

            ПотокЗаписи.СброситьБуферы()
            ПотокЗаписи.Закрыть()
            Консоль.Записать("Processed successfully")
        ;
    поймать Исключение: Исключение
        Консоль.Записать("Error while processing\n" + Исключение.Описание + "\н")
    ;
;